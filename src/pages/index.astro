---
import Layout from '../layouts/Layout.astro';
import Header from '../components/astro/Header.astro';
import Hero from '../components/astro/Hero.astro';
import Productos from '../components/astro/Productos.astro';
import Servicios from '../components/astro/Servicios.astro';
import Proceso from '../components/astro/Proceso.astro';
import QuienesSomos from '../components/astro/QuienesSomos.astro';
import FaqSection from '../components/astro/FaqSection.astro';
import Contacto from '../components/astro/Contacto.astro';
import Footer from '../components/astro/Footer.astro';
---

<Layout preloadImage="/assets/fotos/cuaderno.webp">
  <Header current="inicio" />
  <main id="contenido">
    <Hero />
    <Productos />
    <Servicios />
    <Proceso />
    <QuienesSomos />
    <FaqSection />
    <Contacto />
  </main>
  <Footer />
</Layout>
