---
import '../../styles/global.css';
import LoginForm from '../../components/admin/LoginForm.jsx';
import Logo from '../../components/astro/Logo.astro';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>Iniciar sesión | Panel de catálogo Puka Yurac</title>

    <!-- Tema: mismo criterio que el sitio público -->
    <script is:inline>
      (function () {
        try {
          var theme = localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          document.documentElement.classList.toggle('dark', theme === 'dark');
        } catch (e) {}
      })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Manrope:wght@400..800&family=Archivo:wdth,wght@62..125,400..900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="ui-page-bg ui-text-primary antialiased min-h-screen flex items-center justify-center px-5 py-12">
    <main class="w-full max-w-[400px]">
      <a href="/" class="inline-flex items-center min-h-11">
        <Logo class="h-10" />
      </a>

      <h1 class="mt-8 font-sans text-[32px] sm:text-[40px] leading-[1.05] font-extrabold tracking-[-0.03em]">
        Panel de catálogo
      </h1>
      <p class="mt-3 text-base leading-relaxed ui-text-secondary">
        Ingresa con tu correo para publicar, ocultar o editar productos.
      </p>

      <div class="mt-8">
        <LoginForm client:only="react" />
      </div>

      <p class="mt-8 pt-6 border-t ui-border">
        <a href="/" class="inline-flex items-center min-h-11 text-[15px] font-semibold ui-text-secondary underline-offset-[5px] hover:underline">
          Volver al sitio
        </a>
      </p>
    </main>
  </body>
</html>
