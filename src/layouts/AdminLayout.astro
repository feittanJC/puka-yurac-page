---
import '../styles/global.css';
import Logo from '../components/astro/Logo.astro';

interface Props {
  title?: string;
}

const { title = "Panel de catálogo | Puka Yurac" } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>

    <!-- Tema: mismo criterio que el sitio público (localStorage "theme" o preferencia del sistema) -->
    <script is:inline>
      (function () {
        try {
          var theme = localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          document.documentElement.classList.toggle('dark', theme === 'dark');
        } catch (e) {}
      })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Manrope:wght@400..800&family=Archivo:wdth,wght@62..125,400..900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="ui-page-bg ui-text-primary antialiased min-h-screen flex flex-col">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:px-4 focus:py-3 focus:rounded-xl ui-surface-bg ui-text-primary font-semibold"
    >
      Saltar al contenido
    </a>

    <header class="sticky top-0 z-50 h-[72px] shrink-0 ui-surface-bg border-b ui-border">
      <div class="h-full max-w-[1760px] mx-auto px-4 sm:px-8 xl:px-12 flex items-center justify-between gap-4">
        <div class="flex items-center gap-5 min-w-0">
          <a href="/admin/dashboard" class="shrink-0 inline-flex items-center min-h-11">
            <Logo class="h-7 sm:h-8" />
          </a>
          <span aria-hidden="true" class="hidden md:block w-px h-7 bg-[var(--border-main)]"></span>
          <span class="hidden md:block text-[15px] font-bold truncate">Panel de catálogo</span>
        </div>

        <nav aria-label="Cuenta" class="flex items-center gap-1 sm:gap-2 shrink-0">
          <a
            href="/"
            class="inline-flex items-center h-11 px-3 text-[15px] font-semibold ui-text-primary underline-offset-[5px] hover:underline"
          >
            Ver sitio
          </a>
          <button
            id="btn-logout"
            type="button"
            class="h-11 px-4 rounded-xl ui-elevated-bg hover:bg-[var(--border-main)] ui-text-primary text-[15px] font-semibold cursor-pointer transition-colors"
          >
            Cerrar sesión
          </button>
        </nav>
      </div>
    </header>

    <main id="contenido" class="flex-1 w-full max-w-[1760px] mx-auto px-4 sm:px-8 xl:px-12 pt-8 lg:pt-10 pb-12">
      <slot />
    </main>

    <script>
      import { authService } from '../services/auth.service';

      document.getElementById('btn-logout')?.addEventListener('click', () => authService.logout());
    </script>
  </body>
</html>
