---
import { siteData } from '../../data/siteData';
---

<section id="nosotros" aria-labelledby="nos-title" class="container-page pt-[72px] lg:pt-28">
  <div class="grid items-center gap-8 lg:grid-cols-2 lg:gap-20">
    <div>
      <p class="text-sm font-semibold ui-text-secondary lg:text-[15px]">Nosotros</p>
      <h2
        id="nos-title"
        class="mt-3 mb-4 text-[30px] leading-[1.08] font-extrabold tracking-[-0.03em] lg:mt-4 lg:mb-5 lg:text-[44px] lg:leading-[1.05]"
      >
        Un <span class="text-gradient-red">taller</span> gráfico en Breña con más de 10 años de oficio.
      </h2>
      <p class="max-w-[520px] text-base leading-[1.6] ui-text-secondary lg:text-[17px]">
        Imprimimos para empresas, instituciones, colegios y emprendedores de Lima y de provincias. Algunas empresas que
        confían en nosotros:
      </p>

      <ul class="mt-7 border-b ui-border lg:mt-10">
        {siteData.clientes.map((c) => (
          <li class="border-t ui-border py-[18px] lg:py-5">
            <span class="block font-sans text-[30px] leading-[1.1] font-extrabold tracking-[-0.02em] [font-stretch:100%] lg:text-[40px]">
              {c.nombre}
            </span>
            <span class="mt-1 block text-[15px] ui-text-secondary lg:mt-1.5">{c.trabajo}</span>
          </li>
        ))}
      </ul>
    </div>

    <figure class="m-0">
      <div class="photo-plate h-[290px] rounded-2xl! p-4! md:h-[420px] lg:h-[520px] lg:rounded-[20px]! lg:p-8!">
        <img
          src="/assets/fotos/background.webp"
          width="1327"
          height="967"
          alt="Collage de trabajos del taller: bolsas, tarjetas, cuadernos anillados, agendas, calendarios y folletos"
          loading="lazy"
          decoding="async"
        />
      </div>
      <figcaption class="mt-3 text-sm ui-text-tertiary">Algunos trabajos que salieron del taller.</figcaption>
    </figure>
  </div>
</section>
