---
import { siteData, whatsappUrl } from '../../data/siteData';

const categorias = siteData.categorias.map((c, i) => ({
  ...c,
  n: String(i + 1).padStart(2, '0'),
  href: `/productos?cat=${encodeURIComponent(c.nombre)}`,
}));
---

<section id="inicio" aria-labelledby="hero-title" class="container-page pt-8 lg:pt-[72px]">
  <div class="grid items-center gap-6 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,1fr)] lg:gap-16">
    <div>
      <p class="text-sm font-semibold ui-text-secondary lg:text-[15px]">
        Taller gráfico en Breña, Lima · Más de 10 años de oficio
      </p>
      <h1
        id="hero-title"
        class="mt-3.5 mb-[18px] text-[40px] leading-[1.02] font-extrabold tracking-[-0.035em] md:text-[56px] lg:mt-5 lg:mb-7 xl:text-[72px] xl:leading-[0.98]"
      >
        Impresión que representa la personalidad de tu marca.
      </h1>
      <p class="max-w-[520px] text-[17px] leading-[1.55] ui-text-secondary lg:text-[19px]">
        Agendas, cuadernos, talonarios, folletos y calendarios hechos en nuestro taller. Te enviamos una prueba antes de
        imprimir y despachamos a todo el Perú.
      </p>

      <div class="mt-7 flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-8 lg:mt-10">
        <a
          href={whatsappUrl()}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-anim inline-flex h-14 items-center justify-center gap-3 rounded-xl bg-(--action) px-7 text-base font-bold text-white transition-colors hover:bg-(--action-hover)"
        >
          Cotizar ahora
          <svg data-arrow width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6"></path>
          </svg>
        </a>
        <a
          href="/productos"
          class="link-anim inline-flex h-13 items-center justify-center rounded text-base font-bold ui-text-primary sm:h-14"
        >
          Ver catálogo completo
        </a>
      </div>
    </div>

    <figure class="m-0">
      <div class="photo-plate h-[280px] rounded-2xl! p-7! md:h-[420px] lg:h-[560px] lg:rounded-[20px]! lg:p-12!">
        <img
          src="/assets/fotos/cuaderno.webp"
          width="1600"
          height="1000"
          alt="Cuaderno de tapa dura con portada kraft impresa y logo de Puka & Yurac, junto a un lapicero"
          fetchpriority="high"
          decoding="async"
        />
      </div>
      <figcaption class="mt-3 text-sm ui-text-tertiary">Cuaderno de tapa dura hecho en el taller.</figcaption>
    </figure>
  </div>

  <div class="mt-12 lg:mt-[88px]">
    <div class="mb-3 flex items-baseline justify-between gap-6 lg:mb-5">
      <h2 class="text-xl font-bold [font-stretch:108%] lg:text-[22px]">Qué imprimimos</h2>
      <a
        href="/productos"
        class="link-anim hidden rounded text-[15px] font-bold ui-text-primary md:inline"
      >
        Ver las {categorias.length} categorías
      </a>
    </div>
    <ol class="grid border-b border-(--text-primary) md:grid-cols-2 md:gap-x-12 md:border-b-0 lg:grid-cols-3">
      {categorias.map((c) => (
        <li class="border-t border-(--text-primary)">
          <a
            href={c.href}
            class="cat-link group grid min-h-11 grid-cols-[40px_minmax(0,1fr)] gap-x-0 gap-y-0.5 py-4 ui-text-primary lg:grid-cols-[48px_minmax(0,1fr)] lg:gap-y-1 lg:pt-5 lg:pb-7"
          >
            <span class="cat-num pt-[3px] font-sans text-[15px] font-bold tabular-nums text-(--primary) lg:pt-[5px] lg:text-base">{c.n}</span>
            <span class="cat-name font-sans text-xl leading-[1.2] font-bold [font-stretch:106%] lg:text-2xl">
              {c.nombre}
            </span>
            <span></span>
            <span class="font-mono text-[12.5px] ui-text-tertiary lg:text-[13px]">{c.spec}</span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</section>
