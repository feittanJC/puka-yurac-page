---
import type { Producto } from '../../types/producto';
import { whatsappProductoUrl } from '../../data/siteData';
import { imagenOptimizada } from '../../lib/imagen';

interface Props {
  producto: Producto;
  /** "landing": plato 360px y título h3. "catalogo": plato 320px y título h2. */
  variant?: 'landing' | 'catalogo';
}

const { producto: p, variant = 'landing' } = Astro.props;
const Heading = variant === 'catalogo' ? 'h2' : 'h3';
const img = imagenOptimizada(p.imagen);
const spec = p.acabados.slice(0, 2).join(' · ');
const plateHeight = variant === 'catalogo' ? 'lg:h-[320px]' : 'lg:h-[360px]';
---

<article class="product-card" data-category={p.categoria}>
  <div
    class:list={['card-plate photo-plate h-[260px] rounded-2xl! p-6! md:h-[300px] lg:rounded-[20px]! lg:p-9!', plateHeight]}
    hidden={!img}
  >
    <img class="card-img" src={img || undefined} alt={p.titulo} width="800" height="600" loading="lazy" decoding="async" />
  </div>
  <div
    class:list={['card-plate-empty photo-plate photo-plate--empty h-[260px] rounded-2xl! p-6! md:h-[300px] lg:rounded-[20px]! lg:p-8!', plateHeight]}
    hidden={!!img}
  >
    <span class="card-empty-name font-sans text-[30px] leading-[1.02] font-extrabold tracking-[-0.03em] text-[#3a3c40] [font-stretch:112%] lg:text-4xl" aria-hidden="true">
      {p.titulo}
    </span>
    <span class="mt-2.5 text-[13px] font-semibold text-[#5f6268]">Foto próximamente</span>
  </div>

  <p class="card-cat mt-4 mb-1 text-sm font-semibold ui-text-tertiary lg:mt-5 lg:mb-1.5">{p.categoria}</p>
  <Heading class="card-title text-[22px] leading-[1.2] font-bold [font-stretch:106%] lg:text-2xl">{p.titulo}</Heading>
  <p class="card-desc mt-2 text-base leading-[1.55] ui-text-secondary" hidden={!p.descripcion}>{p.descripcion}</p>
  <div class="mt-3 flex flex-wrap items-center justify-between gap-x-4 lg:mt-4">
    <span class="card-spec font-mono text-[13px] ui-text-secondary">{spec}</span>
    <a
      class="card-cta link-anim link-anim--accent inline-flex min-h-12 items-center rounded text-base font-bold ui-text-primary lg:min-h-11 lg:text-[15px]"
      href={whatsappProductoUrl(p.titulo)}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`Cotizar este producto: ${p.titulo}, por WhatsApp`}
    >
      Cotizar este producto
    </a>
  </div>
</article>
