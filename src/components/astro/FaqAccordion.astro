---
import { siteData } from '../../data/siteData';
---

<div class="faq-accordion border-b ui-border">
  {siteData.faqs.map((faq, i) => {
    const open = i === 0;
    const btnId = `faq-btn-${i}`;
    const panelId = `faq-panel-${i}`;
    return (
      <div class="border-t ui-border">
        <h3>
          <button
            type="button"
            id={btnId}
            aria-expanded={open ? 'true' : 'false'}
            aria-controls={panelId}
            class="faq-toggle flex min-h-16 w-full cursor-pointer items-center justify-between gap-4 py-4 text-left font-sans text-lg leading-[1.3] font-bold ui-text-primary [font-stretch:104%] lg:min-h-[84px] lg:gap-6 lg:py-5 lg:text-[22px] lg:[font-stretch:106%]"
          >
            <span>{faq.pregunta}</span>
            <span aria-hidden="true" class="faq-sign font-(family-name:--font-body) text-[26px] leading-none font-normal lg:text-[28px]">
              {open ? '−' : '+'}
            </span>
          </button>
        </h3>
        <div id={panelId} role="region" aria-labelledby={btnId} hidden={!open} class="pb-[22px] lg:pr-20 lg:pb-7">
          <p class="mb-2.5 text-base leading-[1.6] ui-text-secondary lg:mb-3 lg:text-[17px]">{faq.respuesta}</p>
          <span class="inline-block rounded-md bg-[#fbeec0] px-2.5 py-[3px] text-[13px] font-bold text-[#5c4400]">
            Texto provisional
          </span>
        </div>
      </div>
    );
  })}
</div>

<script>
  document.querySelectorAll<HTMLElement>('.faq-accordion').forEach((root) => {
    root.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.faq-toggle');
      if (!btn) return;
      const open = btn.getAttribute('aria-expanded') !== 'true';
      btn.setAttribute('aria-expanded', String(open));
      const sign = btn.querySelector('.faq-sign');
      if (sign) sign.textContent = open ? '−' : '+';
      const panel = document.getElementById(btn.getAttribute('aria-controls') ?? '');
      if (panel) panel.hidden = !open;
    });
  });
</script>
