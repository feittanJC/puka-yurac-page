---
import { siteData } from '../../data/siteData';
import { faqsService } from '../../services/contenido.service';

// En build se leen de Supabase (panel admin → Preguntas frecuentes); en el navegador se refrescan.
// Sin datos (tabla vacía o sin conexión) se usan los textos provisionales de siteData.
const remotas = await faqsService.getPublic();
const provisional = !remotas?.length;
const faqs: { pregunta: string; respuesta: string }[] = provisional ? siteData.faqs : remotas!;
---

<div class="faq-accordion border-b ui-border" data-provisional={provisional ? 'true' : 'false'}>
  {faqs.map((faq, i) => {
    const open = i === 0;
    const btnId = `faq-btn-${i}`;
    const panelId = `faq-panel-${i}`;
    return (
      <div class="faq-item border-t ui-border">
        <h3>
          <button
            type="button"
            id={btnId}
            aria-expanded={open ? 'true' : 'false'}
            aria-controls={panelId}
            class="faq-toggle flex min-h-16 w-full cursor-pointer items-center justify-between gap-4 py-4 text-left font-sans text-lg leading-[1.3] font-bold ui-text-primary [font-stretch:104%] lg:min-h-[84px] lg:gap-6 lg:py-5 lg:text-[22px] lg:[font-stretch:106%]"
          >
            <span class="faq-q">{faq.pregunta}</span>
            <span aria-hidden="true" class="faq-sign font-(family-name:--font-body) text-[26px] leading-none font-normal lg:text-[28px]">
              {open ? '−' : '+'}
            </span>
          </button>
        </h3>
        <div id={panelId} role="region" aria-labelledby={btnId} hidden={!open} class="faq-panel pb-[22px] lg:pr-20 lg:pb-7">
          <p class="faq-a mb-2.5 text-base leading-[1.6] whitespace-pre-line ui-text-secondary lg:mb-3 lg:text-[17px]">{faq.respuesta}</p>
          {provisional && (
            <span class="faq-badge inline-block rounded-md bg-[#fbeec0] px-2.5 py-[3px] text-[13px] font-bold text-[#5c4400]">
              Texto provisional
            </span>
          )}
        </div>
      </div>
    );
  })}
</div>

<script>
  import { faqsService } from '../../services/contenido.service';

  function bind(root: HTMLElement) {
    root.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.faq-toggle');
      if (!btn) return;
      const open = btn.getAttribute('aria-expanded') !== 'true';
      btn.setAttribute('aria-expanded', String(open));
      const sign = btn.querySelector('.faq-sign');
      if (sign) sign.textContent = open ? '−' : '+';
      const panel = document.getElementById(btn.getAttribute('aria-controls') ?? '');
      if (panel) panel.hidden = !open;
    });
  }

  /** Reemplaza las preguntas con las publicadas en el panel (clona la primera como molde). */
  async function refresh(root: HTMLElement) {
    const faqs = await faqsService.getPublic();
    if (!faqs?.length) return; // sin datos: se queda lo renderizado en el build
    const molde = root.querySelector<HTMLElement>('.faq-item');
    if (!molde) return;

    const items = faqs.map((faq, i) => {
      const item = molde.cloneNode(true) as HTMLElement;
      const btn = item.querySelector<HTMLButtonElement>('.faq-toggle')!;
      const panel = item.querySelector<HTMLElement>('.faq-panel')!;
      const open = i === 0;
      btn.id = `faq-btn-${i}`;
      btn.setAttribute('aria-controls', `faq-panel-${i}`);
      btn.setAttribute('aria-expanded', String(open));
      item.querySelector('.faq-sign')!.textContent = open ? '−' : '+';
      item.querySelector('.faq-q')!.textContent = faq.pregunta;
      item.querySelector('.faq-a')!.textContent = faq.respuesta;
      item.querySelector('.faq-badge')?.remove();
      panel.id = `faq-panel-${i}`;
      panel.setAttribute('aria-labelledby', btn.id);
      panel.hidden = !open;
      return item;
    });
    root.replaceChildren(...items);
    root.dataset.provisional = 'false';
  }

  document.querySelectorAll<HTMLElement>('.faq-accordion').forEach((root) => {
    bind(root);
    refresh(root).catch(() => {});
  });
</script>
