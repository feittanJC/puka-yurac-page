---
import { siteData, whatsappUrl } from '../../data/siteData';
import ThemeToggle from './ThemeToggle.astro';
import WhatsAppIcon from './WhatsAppIcon.astro';

interface Props {
  links: { href: string; label: string; key?: string }[];
  current?: string;
}

const { links, current } = Astro.props;
---

<div class="lg:hidden">
  <button
    type="button"
    id="mobile-menu-trigger"
    aria-label="Abrir menú"
    aria-expanded="false"
    aria-controls="mobile-drawer"
    class="inline-flex h-11 w-11 cursor-pointer items-center justify-center rounded-[10px] ui-text-primary"
  >
    <svg data-icon="open" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <path d="M4 7h16M4 12h16M4 17h16"></path>
    </svg>
    <svg data-icon="close" class="hidden" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <path d="M6 6l12 12M18 6L6 18"></path>
    </svg>
  </button>

  <div
    id="mobile-drawer"
    hidden
    class="fixed inset-x-0 bottom-0 top-[68px] z-40 overflow-y-auto ui-page-bg px-5 pb-10 pt-4"
  >
    <nav aria-label="Menú móvil">
      <ul class="border-b ui-border">
        {links.map((l) => (
          <li class="border-t ui-border">
            <a
              href={l.href}
              aria-current={l.key && l.key === current ? 'page' : undefined}
              class="mobile-nav-link flex min-h-14 items-center font-sans text-[22px] font-bold ui-text-primary [font-stretch:106%] aria-[current=page]:underline aria-[current=page]:decoration-(--accent-text) aria-[current=page]:decoration-2 aria-[current=page]:underline-offset-8"
            >
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="mt-8 flex flex-col gap-2">
      <a
        href={whatsappUrl()}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-anim flex h-14 items-center justify-center gap-2.5 rounded-xl bg-(--whatsapp) text-base font-bold text-white"
      >
        <WhatsAppIcon />
        Escríbenos por WhatsApp
      </a>
      <a href={siteData.phoneHref} class="flex h-13 items-center justify-center text-base font-bold ui-text-primary underline underline-offset-[6px]">
        Llamar al {siteData.phoneShort}
      </a>
    </div>

    <div class="mt-8 flex items-center justify-between border-t ui-border pt-4">
      <span class="text-[15px] font-semibold ui-text-secondary">Modo de color</span>
      <ThemeToggle />
    </div>
  </div>
</div>

<script>
  const trigger = document.getElementById('mobile-menu-trigger');
  const drawer = document.getElementById('mobile-drawer');

  const setOpen = (open: boolean) => {
    if (!trigger || !drawer) return;
    drawer.hidden = !open;
    trigger.setAttribute('aria-expanded', String(open));
    trigger.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    trigger.querySelector('[data-icon="open"]')?.classList.toggle('hidden', open);
    trigger.querySelector('[data-icon="close"]')?.classList.toggle('hidden', !open);
    document.body.style.overflow = open ? 'hidden' : '';
  };

  trigger?.addEventListener('click', () => setOpen(drawer?.hasAttribute('hidden') ?? false));
  drawer?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && drawer && !drawer.hidden) {
      setOpen(false);
      trigger?.focus();
    }
  });
  // Si se agranda la ventana a escritorio con el menú abierto
  window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => {
    if (e.matches) setOpen(false);
  });
</script>
